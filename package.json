{
  "name": "kyle-vueuse",
  "version": "1.0.0",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "lint": "eslint --fix",
    "commit": "git-cz",
    "prepare": "husky",
    "spellcheck": "cspell lint --dot --gitignore --cache --show-suggestions  \"(packages|apps)/**/*.@(html|js|cjs|mjs|ts|tsx|css|scss|md)\""
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  },
  "keywords": [
    "vueuse",
    "hooks",
    "composition-api",
    "utils"
  ],
  "author": "Kyle",
  "email": "lovelykein@foxmail.com",
  "license": "ISC",
  "description": "VueUse Composition API",
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "eslint-plugin-vue": "^10.6.2",
    "globals": "^16.5.0",
    "typescript-eslint": "^8.48.1",
    "eslint-plugin-simple-import-sort": "^12.1.0",
    "husky": "^9.1.6",
    "commitizen": "^4.3.1",
    "cz-git": "1.12.0",
    "cspell": "^9.4.0"
  }
}

{
  "name": "kyle-vueuse",
  "version": "1.0.0",
  "main": "index.js",
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "lint": "eslint --fix",
    "commit": "git-cz",
    "prepare": "husky",
    "typecheck": "pnpm --filter \"...[origin/main]\" run typecheck",
    "test": "pnpm --filter \"...[origin/main]\" run test",
    "spellcheck": "cspell lint --dot --gitignore --show-suggestions  \"(packages|apps)/**/*.@(html|js|cjs|mjs|ts|tsx|css|scss|md)\"",
    "dev:doc": "pnpm --filter website dev",
    "build:doc": "pnpm --filter website build",
    "dev:core": "pnpm --filter core dev",
    "build:core": "pnpm --filter core build",
    "publish:core": "pnpm --filter core publish",
    "dev:components": "pnpm --filter components dev",
    "build:components": "pnpm --filter components build"
  },
  "config": {
    "commitizen": {
      "path": "node_modules/cz-git"
    }
  },
  "keywords": [
    "vueuse",
    "hooks",
    "composition-api",
    "utils",
    "components",
    "vue3"
  ],
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx,vue}": [
      "eslint --fix",
      "prettier --cache --write"
    ],
    "**/*.{css,scss,less,sass}": [
      "prettier --cache --write"
    ],
    "**/*.{md,json,html,yml,yaml}": [
      "prettier --cache --write"
    ]
  },
  "author": "Kyle",
  "email": "lovelykein@foxmail.com",
  "license": "MIT",
  "description": "VueUse Composition API",
  "devDependencies": {
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@commitlint/format": "^21.0.1",
    "@eslint/js": "^9.39.1",
    "@types/node": "^25.9.1",
    "@vue/test-utils": "^2.4.11",
    "commitizen": "^4.3.1",
    "commitlint": "^21.0.1",
    "cspell": "^9.4.0",
    "cz-git": "1.12.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-simple-import-sort": "^12.1.0",
    "eslint-plugin-vue": "^10.6.2",
    "globals": "^16.5.0",
    "happy-dom": "^20.10.4",
    "husky": "^9.1.6",
    "lint-staged": "^17.0.5",
    "np": "^10.2.0",
    "nrm": "^2.1.0",
    "prettier": "^3.8.3",
    "turbo": "^2.6.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.48.1",
    "vitest": "^4.1.9",
    "vue-eslint-parser": "^10.4.0",
    "vue-tsc": "^3.3.2"
  }
}

{
  "name": "@kyle-vueuse/core",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "sideEffects": false,
  "files": [
    "dist",
    "package.json"
  ],
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "typecheck": "vue-tsc --noEmit",
    "publish": "np --no-publish --branch=master && npm publish"
  },
  "keywords": [],
  "author": "Kyle",
  "email": "lovelykein@foxmail.com",
  "license": "ISC",
  "description": "Vue Composition API",
  "dependencies": {
    "vue": "~3.5.25",
    "vue-demi": "^0.14.10"
  },
  "devDependencies": {
    "@rollup/plugin-typescript": "^12.3.0",
    "rollup": "^4.53.3"
  }
}

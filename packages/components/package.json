{
  "name": "@kyle-vueuse/components",
  "version": "1.0.0",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "!**/__tests__/**"
  ],
  "scripts": {
    "build": "vite build && vue-tsc --emitDeclarationOnly",
    "build:css-in-js": "vite build --config vite.config.cssInJs.ts && vue-tsc --emitDeclarationOnly",
    "build:style": "vite build --config vite.config.onStyleCss.ts && vue-tsc --emitDeclarationOnly",
    "build:component-css": "vite build --config vite.config.componentCss.ts && vue-tsc --emitDeclarationOnly",
    "build:component-css-in-js": "vite build --config vite.config.componentCssInJs.ts && vue-tsc --emitDeclarationOnly",
    "test": "vitest run --passWithNoTests",
    "typecheck": "vue-tsc --noEmit"
  },
  "keywords": [
    "vue",
    "vue3",
    "components"
  ],
  "author": "Kyle",
  "email": "lovelykein@foxmail.com",
  "license": "ISC",
  "description": "Kyle-VueUse 组件库",
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@kyle-vueuse/hooks": "workspace:*"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.7",
    "sass-embedded": "^1.100.0",
    "vite": "^8.1.1",
    "vite-plugin-css-injected-by-js": "^5.0.2",
    "vue": "^3.5.39"
  }
}
